<div class="container-large-contact">
          <div class="w-layout-grid contact_component">
            <div class="div-block-11"><img src="{{ '65a29462d068c3c35007ec1a_CONTACT-55.avif' | asset_url }}" loading="lazy" alt="" class="image-4"></div>
            <div class="contact_content">
              <div class="margin-bottom margin-small">
                <h1 class="heading-style-h2">
{{ section.settings.text_heading }}
</h1>
              </div>
              <p class="text-size-medium">
{{ section.settings.text_paragraph }}
</p>
            </div>
            <div class="w-embed w-script"><!--  Pawa Speed Sports Contact Form  -->
              <!--  Paste this entire block into a Webflow HTML Embed element  -->
              <!--  It posts to Shopify's /contact endpoint and handles success/error states via JS  -->
              <form id="pawa-contact-form" action="/contact#contact_form" method="POST" accept-charset="UTF-8">
                <!--  These hidden inputs are required by Shopify's contact form handler  -->
                <input type="hidden" name="form_type" value="contact">
                <input type="hidden" name="utf8" value="✓">
                <div class="form_field-wrapper">
                  <label for="pawa-first-name" class="form_field-label">First Name</label>
                  <input class="form_input w-input" id="pawa-first-name" name="contact[first_name]" type="text" required="" maxlength="256">
                </div>
                <div class="form_field-wrapper">
                  <label for="pawa-last-name" class="form_field-label">Last Name</label>
                  <input class="form_input w-input" id="pawa-last-name" name="contact[last_name]" type="text" required="" maxlength="256">
                </div>
                <div class="form_field-wrapper">
                  <label for="pawa-email" class="form_field-label">Email</label>
                  <input class="form_input w-input" id="pawa-email" name="contact[email]" type="email" required="" maxlength="256">
                </div>
                <div class="form_field-wrapper">
                  <label for="pawa-message" class="form_field-label">Message</label>
                  <textarea class="form_input is-text-area w-input" id="pawa-message" name="contact[body]" required="" maxlength="5000"></textarea>
                </div>
                <div class="margin-bottom margin-xsmall">
                  <label class="w-checkbox form_checkbox">
                    <input type="checkbox" required="" style="opacity:0;position:absolute;z-index:-1">
                    <div class="form_checkbox-icon w-checkbox-input w-checkbox-input--inputType-custom"></div>
                    <span class="form_checkbox-label text-size-small w-form-label">
                      I accept the Terms
                    </span>
                  </label>
                </div>
                <input type="submit" class="button w-button" value="Submit" id="pawa-submit-btn">
                <a href="mailto:contact@pawaspeedsports.com?subject=Pawa%20Speed%20Sports%20%7C%20General%20Enquiry" class="link">contact@pawaspeedsports.com</a>
              </form>
              <!--  Success message (hidden until form submitted successfully)  -->
              <div id="pawa-success" class="success-message w-form-done" style="display:none;">
                <div class="success-text">Thank you! Your submission has been received!</div>
              </div>
              <!--  Error message (hidden until a submission error occurs)  -->
              <div id="pawa-error" class="error-message w-form-fail" style="display:none;">
                <div class="error-text">Oops! Something went wrong while submitting the form.</div>
              </div>
              <script>
  (function () {
    var form = document.getElementById('pawa-contact-form');
    var submitBtn = document.getElementById('pawa-submit-btn');
    var successMsg = document.getElementById('pawa-success');
    var errorMsg = document.getElementById('pawa-error');
    form.addEventListener('submit', async function (e) {
      e.preventDefault(); // Stop normal page redirect
      // Reset messages
      successMsg.style.display = 'none';
      errorMsg.style.display = 'none';
      // Disable button to prevent double submit
      submitBtn.value = 'Sending&hellip;';
      submitBtn.disabled = true;
      var formData = new FormData(form);
      try {
        var response = await fetch('/contact', {
          method: 'POST',
          headers: {
            'Accept': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: formData
        });
        if (response.ok) {
          // Hide the form, show success
          form.style.display = 'none';
          successMsg.style.display = 'block';
        } else {
          throw new Error('Non-OK response: ' + response.status);
        }
      } catch (err) {
        // Show error, re-enable button
        errorMsg.style.display = 'block';
        submitBtn.value = 'Submit';
        submitBtn.disabled = false;
      }
    });
  })();
</script>
            </div>
            <div class="contact_form-block w-form">
              <div class="success-message w-form-done">
                <div class="success-text">Thank you! Your submission has been received!</div>
              </div>
              <div class="error-message w-form-fail">
                <div class="error-text">Oops! Something went wrong while submitting the form.</div>
              </div>
            </div>
          </div>
        </div> {% schema %} {
    "tag": "section",
    "name": "Contact",
    "class": "section_contact",
    "settings": [
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Contact us"
        },
        {
            "id": "text_paragraph",
            "type": "text",
            "label": "Paragraph",
            "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit."
        }
    ],
    "presets": [
        {
            "name": "Contact",
            "category": "Liquify",
            "blocks": []
        }
    ]
} {% endschema %}