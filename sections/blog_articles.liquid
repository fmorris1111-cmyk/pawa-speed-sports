{% paginate blog.articles by 50 %}
    <div li-paginate:by="50" li-paginate="blog.articles" class="padding-global padding-section-small" by="50">
          <div class="container-large">
            <div class="blog_cms-wrapper w-dyn-list">
              {% if blog.articles != blank %}    <div li-if="blog.articles != blank" role="list" class="blog_list w-dyn-items">
    
                {% for article in blog.articles %}    <div li-for="article in blog.articles" role="listitem" class="blog_cms-item w-dyn-item">
                                    
                  
                            <a li-object:href="article.url" href="{{ article.url }}" class="blog_item-grid w-inline-block">
                    <div id="w-node-c45bff24-6242-fee4-5061-f2f14b06a7be-4b06a7bd" class="blog_tags-wrapper"><img src="{{ article.image | image_url: width: 450 }}" loading="lazy" id="w-node-c45bff24-6242-fee4-5061-f2f14b06a7bf-4b06a7bd" li-object:src="article.image | image_url: width: 450" alt="{{ article.image.alt }}" li-object:alt="article.image.alt" class="blog_img"></div>
                    <div class="blog_featured-item-content">
                      <h3 li-object="article.title" class="heading-style-h3">{{ article.title }}</h3>
                      <div li-object="article.title" class="blog-card_title">{{ article.title }}</div>
                      <div li-object="article.published_at | date: '%B %d, %Y'" class="text-size-regular">{{ article.published_at | date: '%B %d, %Y' }}</div>
                    </div>
                  </a>
                            
                
                        </div>
{% endfor %}
                  </div>
{% endif %}
              {% if blog.articles == blank %}    <div li-if="blog.articles == blank" class="blog_cms-empty w-dyn-empty">
    
                <div>No blog items found.</div>
                  </div>
{% endif %}
            </div>
          </div>
        </div>{% endpaginate %} {% schema %} {
    "tag": "section",
    "name": "Blog-Articles",
    "class": "section_blog-list",
    "presets": [
        {
            "name": "Blog-Articles",
            "category": "Liquify",
            "blocks": []
        }
    ],
    "enabled_on": {
        "templates": [
            "blog"
        ]
    }
} {% endschema %}