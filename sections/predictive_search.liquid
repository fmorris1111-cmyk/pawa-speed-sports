{% if predictive_search.performed %}    <div li-if="predictive_search.performed">
    
                            {% assign ps_count = predictive_search.resources.products.size %}
                            {% if ps_count > 0 %}    <div li-if="ps_count > 0">
    
                              <p class="predictive-search_label">FIRST 10 RESULTS</p>
                              <ul class="predictive-search_list w-list-unstyled">
                                {% for product in predictive_search.resources.products %}
                                {% unless product.tags contains 'gift-hidden' %}
                                <li class="predictive-search_item">
                                  <a href="{{ product.url }}" class="predictive-search_line-item w-inline-block">
                                    <div class="predictive-search_img-wrap">
                                      <img src="{{ product.featured_media | image_url: width: 150 }}" alt="{{ product.featured_image.alt }}" loading="lazy" class="predictive-search_img">
                                    </div>
                                    <div class="predictive-search_product-title text-size_small">{{ product.title }}</div>
                                  </a>
                                </li>
                                {% endunless %}
                                {% endfor %}
                              </ul>
                              <a href="/search?type=product&q={{ predictive_search.terms | url_encode }}" class="predictive-search_see-all w-inline-block">SEE ALL</a>
                                </div>
{% endif %}
                            {% if ps_count == 0 %}    <div li-if="ps_count == 0">
    
                              <p class="predictive-search_empty">No results for “<span li-object="predictive_search.terms">{{ predictive_search.terms }}</span>”</p>
                                </div>
{% endif %}
                              </div>
{% endif %} {% schema %} {
    "tag": "div",
    "name": "predictive_search",
    "class": "predictive-search_wrap",
    "presets": [
        {
            "name": "predictive_search",
            "category": "Liquify",
            "blocks": []
        }
    ]
} {% endschema %}