                <script>
/* &#9472;&#9472; Password form toggle &#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472; */
(function () {
  function initPasswordToggle(root) {
    var scope = root || document;
    var link = scope.querySelector('[data-password-toggle]');
    var wrap = scope.querySelector('[data-password-form]');
    if (!link || !wrap || link.getAttribute('data-pw-bound') === '1') return;
    link.setAttribute('data-pw-bound', '1');
    function openForm() {
      wrap.classList.add('is-open');
      link.setAttribute('aria-expanded', 'true');
      var i = wrap.querySelector('input[type="password"]');
      if (i) i.focus();
    }
    link.setAttribute('aria-expanded', 'false');
    link.addEventListener('click', function (e) {
      e.preventDefault();
      if (wrap.classList.contains('is-open')) {
        wrap.classList.remove('is-open');
        link.setAttribute('aria-expanded', 'false');
      } else {
        openForm();
      }
    });
    if (wrap.querySelector('.errors, .form_error, [data-error]')) openForm();
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { initPasswordToggle(); });
  } else {
    initPasswordToggle();
  }
  document.addEventListener('shopify:section:load', function (e) { initPasswordToggle(e.target); });
})();
/* &#9472;&#9472; Hero: carousel / grid &#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472; */
(function () {
  var MOB = window.matchMedia('(max-width: 767px)');
  var MANUAL_SPEED = 420;
  var insts = [];
  function controls(scope) {
    return {
      ctrls: scope.querySelector('.fp-controls'),
      pag:   scope.querySelector('.fp-pagination'),
      prev:  scope.querySelector('.fp-prev'),
      next:  scope.querySelector('.fp-next'),
      count: scope.querySelector('.pw-count')
    };
  }
  function snapFill(pag) {
    var fill = pag && pag.querySelector('.swiper-pagination-progressbar-fill');
    if (!fill) return;
    fill.style.transitionDuration = '0ms';
    requestAnimationFrame(function () {
      requestAnimationFrame(function () { fill.style.transitionDuration = ''; });
    });
  }
  function wire(sw, c, total) {
    var last = sw.realIndex;
    function sync() {
      if (c.count) c.count.textContent = (sw.realIndex + 1) + ' of ' + total;
      if (last === total - 1 && sw.realIndex === 0) snapFill(c.pag);
      last = sw.realIndex;
    }
    sw.on('slideChange', sync);
    sync();
  }
  function build() {
    insts.forEach(function (s) { try { s.destroy(true, true); } catch (e) {} });
    insts = [];
    var car = document.querySelector('.pw-carousel');
    if (car && window.Swiper) {
      var c = controls(car.parentElement);
      var v = parseInt(car.getAttribute('data-speed'), 10) || 4;
      var AUTO_SPEED = 13000 - v * 1000;
      var total = car.querySelectorAll('.swiper-slide').length;
      var sw = new Swiper(car, MOB.matches
        ? { slidesPerView: 1, spaceBetween: 16, loop: true, grabCursor: true,
            pagination: { el: c.pag, type: 'progressbar' },
            navigation: { prevEl: c.prev, nextEl: c.next } }
        : { slidesPerView: 'auto', spaceBetween: 16, loop: true, grabCursor: true,
            speed: AUTO_SPEED,
            freeMode: { enabled: true, momentum: true },
            autoplay: { delay: 0, disableOnInteraction: false },
            pagination: { el: c.pag, type: 'progressbar' },
            navigation: { prevEl: c.prev, nextEl: c.next } });
      wire(sw, c, total);
      insts.push(sw);
if (!MOB.matches) {
  car.addEventListener('mouseenter', function () { if (sw.autoplay) sw.autoplay.stop(); });
  car.addEventListener('mouseleave', function () { if (sw.autoplay) sw.autoplay.start(); });
}
        hot.forEach(function (el) {
          el.addEventListener('mouseenter', toManual);
          el.addEventListener('mouseleave', toAuto);
        });
      }
    }
    var grid = document.querySelector('.pw-grid');
    if (!grid) return;
    var thumbs = [].slice.call(grid.querySelectorAll('.pw-grid_thumb'));
    var main   = grid.querySelector('.pw-grid_main-img');
    var c2     = controls(grid);
    if (!thumbs.length) return;
    if (MOB.matches && window.Swiper) {
      var sw2 = new Swiper(grid.querySelector('.pw-grid_thumbs'), {
        slidesPerView: 1, spaceBetween: 16, grabCursor: true,
        pagination: { el: c2.pag, type: 'progressbar' },
        navigation: { prevEl: c2.prev, nextEl: c2.next }
      });
      wire(sw2, c2, thumbs.length);
      insts.push(sw2);
      return;
    }
    var i = 0;
    function show(n) {
      i = (n + thumbs.length) % thumbs.length;
      var img = thumbs[i].querySelector('img');
      if (main) {
        main.src = img.currentSrc || img.src;
        if (img.srcset) main.srcset = img.srcset;
      }
      thumbs.forEach(function (t) { t.classList.remove('is-active'); });
      thumbs[i].classList.add('is-active');
      if (c2.count) c2.count.textContent = (i + 1) + ' of ' + thumbs.length;
      if (c2.pag) {
        var fill = c2.pag.querySelector('.swiper-pagination-progressbar-fill');
        if (!fill) {
          fill = document.createElement('span');
          fill.className = 'swiper-pagination-progressbar-fill';
          c2.pag.appendChild(fill);
        }
        fill.style.transform = 'translate3d(0,0,0) scaleX(' + ((i + 1) / thumbs.length) + ') scaleY(1)';
      }
    }
    thumbs.forEach(function (t, n) { t.addEventListener('click', function () { show(n); }); });
    if (c2.prev) c2.prev.addEventListener('click', function (e) { e.preventDefault(); show(i - 1); });
    if (c2.next) c2.next.addEventListener('click', function (e) { e.preventDefault(); show(i + 1); });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft')  show(i - 1);
      if (e.key === 'ArrowRight') show(i + 1);
    });
    show(0);
  }
  build();
  MOB.addEventListener('change', build);
})();
</script>
