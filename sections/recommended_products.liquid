{% if product.metafields.custom.related_products.value.size > 0 %}    <div li-if="product.metafields.custom.related_products.value.size > 0" class="recs-guard">
    
          <div class="w-embed">{% assign current_product_id = product.id %}</div>
          <div class="container-large-recs">
            <div class="headline-wrapper">
              <h2 class="heading-style is-recs">WEAR IT WITH</h2>
            </div>
            <div class="product_list-wrapper swiper is-fp-carousel">
              <ul li-for:inside="product in product.metafields.custom.related_products.value" role="list" class="product_list swiper-wrapper w-list-unstyled">
        {% for product in product.metafields.custom.related_products.value %}                            
                
                            {% if product.id != current_product_id %}    <li li-if="product.id != current_product_id" class="product_list-item swiper-slide">
    
                  {% render 'product_item', product: product %}
                    </li>
{% endif %}
                            
              
                    {% endfor %}    </ul>
            </div>
            <div class="fp-controls-wrap w-embed">
              <div class="fp-controls">
                <button class="fp-prev" aria-label="Previous">
                  <svg width="18" height="18" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M15 18L9 12L15 6" fill="none"></path>
                  </svg>
                </button>
                <div class="fp-pagination"></div>
                <button class="fp-next" aria-label="Next">
                  <svg width="18" height="18" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 18L15 12L9 6" fill="none"></path>
                  </svg>
                </button>
              </div>
            </div>
          </div>
            </div>
{% endif %}
        {% if product.metafields.custom.related_products.value == blank %}    <div li-if="product.metafields.custom.related_products.value == blank" class="recs-guard">
    
          <div class="w-embed">{% assign current_product_id = product.id %}
            {% assign recs_max = 8 %}
            {% for p in collections['all'].products limit: 8 %}{% if p.id == current_product_id %}{% assign recs_max = 9 %}{% endif %}{% endfor %}</div>
          <div class="container-large-recs">
            <div class="headline-wrapper">
              <h2 class="heading-style is-recs">RECOMMENDED</h2>
            </div>
            <div class="product_list-wrapper swiper is-fp-carousel">
              <ul li-for:inside="product in collections['all'].products limit: 9" role="list" class="product_list swiper-wrapper w-list-unstyled">
        {% for product in collections['all'].products limit: 9 %}                            
                
                            {% if product.id != current_product_id and forloop.index <= recs_max %}    <li li-if="product.id != current_product_id and forloop.index <= recs_max" class="product_list-item swiper-slide">
    
                  {% render 'product_item', product: product %}
                    </li>
{% endif %}
                            
              
                    {% endfor %}    </ul>
            </div>
            <div class="fp-controls-wrap w-embed">
              <div class="fp-controls">
                <button class="fp-prev" aria-label="Previous">
                  <svg width="18" height="18" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M15 18L9 12L15 6" fill="none"></path>
                  </svg>
                </button>
                <div class="fp-pagination"></div>
                <button class="fp-next" aria-label="Next">
                  <svg width="18" height="18" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 18L15 12L9 6" fill="none"></path>
                  </svg>
                </button>
              </div>
            </div>
          </div>
            </div>
{% endif %} {% schema %} {
    "tag": "section",
    "name": "Recommended Products",
    "class": "section_product-recommended",
    "presets": [
        {
            "name": "Recommended Products",
            "category": "Liquify",
            "blocks": []
        }
    ],
    "enabled_on": {
        "templates": [
            "product"
        ]
    }
} {% endschema %}