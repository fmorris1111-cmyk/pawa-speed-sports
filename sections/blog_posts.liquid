<div class="padding-global padding-section-medium">
          <div class="container-large">
            <div class="headline-wrapper">
              <h2 class="heading-style-h2">
{{ section.settings.text_heading }}
</h2>
              <a href="{{ section.settings.url_button_link }}" class="button is-small w-button"> {{ section.settings.text_button_text }} </a>
            </div>
            <div class="blog_component">
              <div class="blog_featured-item">
                <div class="blog_featured-image-link">{% assign article = articles[section.settings.article_article] %} 
                  <a li-object:href="article.url" href="{{ article.url }}" class="blog_featured-image-wrapper w-inline-block">
                    <div class="blog_titel-wrapper">
                      <h3 li-object="article.title" class="heading-style-h4">{{ article.title }}</h3>
                      <div li-object="article.excerpt | truncate: 25" class="text-size-regular">{{ article.excerpt | truncate: 25 }}</div>
                    </div><img alt="" loading="lazy" li-object:src="article.image.src | image_url: width: 600" src="{{ article.image.src | image_url: width: 600 }}" class="blog_featured-image">
                    <div class="blog_overlay"></div>
                  </a>
                </div>
                <div id="w-node-_4d7af1cf-0c17-815b-6613-2343dbf24ae7-dbf24ad4" class="blog_two-articles">
                  {% assign blog = blogs[section.settings.blog_blog] %}
{% for article in blog.articles limit: section.settings.post_limit_blog %}
<div class="blog_featured-item-content">

                    <a li-object:href="article.url" href="{{ article.url }}" class="blog_featured-title-link w-inline-block">
                      <h3 li-object="article.title" class="heading-style-h4">{{ article.title }}</h3>
                    </a>
                    <div li-object="article.excerpt | truncate: 25" class="text-size-regular">{{ article.excerpt | truncate: 25 }}</div>
                    <div class="spacer-small">
                      <section li-section="Blog Speed Sounds" class="section_blog">
                        {% paginate blogs['speed-sounds'].articles by 12 %}
    <div li-paginate:by="12" li-paginate="blogs['speed-sounds'].articles" class="blog_component" by="12">
                          {% for article in blogs['speed-sounds'].articles %}    <div li-for="article in blogs['speed-sounds'].articles" class="blog_featured-item">
                                    
                            
                            <div class="blog_featured-image-link">
                              <a li-object:href="article.url" href="{{ article.url }}" class="blog_featured-image-wrapper w-inline-block">
                                <div class="w-embed">{% comment %} Webflow-safe: no Liquid inside HTML tags, and no less-than signs inside Liquid. {% endcomment %}
                                  {% assign ssp_c_alt = article.image.alt | default: article.title | escape %}
                                  {% assign ssp_c_clip = article.metafields.custom.preview_clip.value %}
                                  {% assign ssp_c_src = '' %}{% assign ssp_c_src_sm = '' %}{% assign ssp_c_h = 0 %}{% assign ssp_c_h_sm = 0 %}
                                  {% if ssp_c_clip != blank %}{% for s in ssp_c_clip.sources %}{% if s.format == 'mp4' %}
                                  {% unless s.height > 1080 %}{% if s.height > ssp_c_h %}{% assign ssp_c_h = s.height %}{% assign ssp_c_src = s.url %}{% endif %}{% endunless %}
                                  {% unless s.height > 720 %}{% if s.height > ssp_c_h_sm %}{% assign ssp_c_h_sm = s.height %}{% assign ssp_c_src_sm = s.url %}{% endif %}{% endunless %}
                                  {% endif %}{% endfor %}{% endif %}
                                  {% if ssp_c_src_sm == blank %}{% assign ssp_c_src_sm = ssp_c_src %}{% endif %}
                                  {% comment %} No clip uploaded? Fall back to Bunny's automatic animated preview (lower resolution). {% endcomment %}
                                  {% assign ssp_c_webp = '' %}
                                  {% assign ssp_c_video = article.metafields.custom.video_url.value | default: '' | append: '' %}
                                  {% if ssp_c_src == blank and ssp_c_video contains 'playlist.m3u8' %}{% assign ssp_c_webp = ssp_c_video | split: 'playlist.m3u8' | first | append: 'preview.webp' %}{% endif %}
                                  <span class="ssp-card" data-preview="{{ ssp_c_src }}" data-preview-sm="{{ ssp_c_src_sm }}" data-preview-webp="{{ ssp_c_webp }}">
                                    {% if article.image %}{{ article.image | image_url: width: 1800 | image_tag: widths: '400, 600, 800, 1000, 1200, 1600, 1800', sizes: '(min-width: 992px) 33vw, (min-width: 768px) 50vw, 100vw', loading: 'lazy', alt: ssp_c_alt, class: 'ssp-card_img' }}{% else %}<span class="ssp-card_img ssp-card_img--blank"></span>{% endif %}
                                    <img class="ssp-card_badge" src="{{ 'pstar-badge.png' | file_url }}" alt="" aria-hidden="true" width="120" height="94" loading="lazy">
                                  </span>
                                </div>
                              </a>
                            </div>
                            
                            
                            <div id="w-node-e812e5be-5058-dc0c-9f09-d9e0925fd943-925fd930" class="blog_two-articles">
                              <div class="blog_featured-item-content">
                                <a li-object:href="article.url" href="{{ article.url }}" class="blog_featured-title-link w-inline-block">
                                  <h3 li-object="article.title" class="blog-card_title">{{ article.title }}</h3>
                                </a>
                                <div li-object="article.published_at | date: '%B %d, %Y'" class="text-size-regular">{{ article.published_at | date: '%B %d, %Y' }}</div>
                                <a li-object:href="article.url" href="{{ article.url }}" class="button is-link is-icon w-inline-block">
                                  <div>WATCH</div>
                                  <div class="icon-embed-xxsmall w-embed"><svg width="16" height="16" viewbox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                      <path d="M6 3L11 8L6 13" stroke="CurrentColor" stroke-width="1.5"></path>
                                    </svg></div>
                                </a>
                              </div>
                            </div>
                            
                          
                        </div>
{% endfor %}
                          <div class="w-embed w-script">
                            <style>
.ssp-card { position: absolute; inset: 0; display: block; overflow: hidden; background: #111; }
.ssp-card_img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .6s cubic-bezier(.2, .7, .2, 1); }
.ssp-card_img--blank { background: #f3f3f3; }
.ssp-card_video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .35s ease; pointer-events: none; }
.ssp-card.is-previewing .ssp-card_video { opacity: 1; }
/* Cards with no preview at all get a gentle zoom instead */
a:hover .ssp-card[data-preview=""][data-preview-webp=""] .ssp-card_img { transform: scale(1.03); }
/* P* glass badge */
.ssp-card_badge { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); z-index: 2; width: 42%; max-width: 16rem; height: auto; pointer-events: none;
  filter: drop-shadow(0 2px 6px rgba(0, 0, 0, .3)); }
/* The old grey hover overlay is no longer used */
.blog_overlay { display: none !important; }
@media (prefers-reduced-motion: reduce) { .ssp-card_img, .ssp-card_video { transition: none; } }
</style>
                            <script>
(function () {
  if (window.__sspCards) return; window.__sspCards = true;
  var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
  var saveData = navigator.connection && navigator.connection.saveData;
  var canHover = window.matchMedia && matchMedia('(hover: hover) and (pointer: fine)').matches;
  function getVideo(card) {
    if (card.__v) return card.__v;
    var webp = card.getAttribute('data-preview-webp');
    if (webp && !card.getAttribute('data-preview')) {
      // Bunny animated preview: an <img> that animates by itself; play/pause = show/hide
      var im = document.createElement('img');
      im.className = 'ssp-card_video'; im.alt = ''; im.setAttribute('aria-hidden', 'true');
      im.addEventListener('load', function () { if (card.__want) card.classList.add('is-previewing'); });
      im.play = function () { if (!im.getAttribute('src')) im.src = webp; else if (im.complete) card.classList.add('is-previewing'); };
      im.pause = function () {};
      card.insertBefore(im, card.querySelector('.ssp-card_badge'));
      card.__v = im;
      return im;
    }
    var v = document.createElement('video');
    v.className = 'ssp-card_video';
    v.muted = true; v.defaultMuted = true; v.loop = true; v.playsInline = true;
    v.setAttribute('muted', ''); v.setAttribute('playsinline', ''); v.setAttribute('aria-hidden', 'true');
    v.preload = 'auto';
    v.src = (window.innerWidth < 768 && card.getAttribute('data-preview-sm')) || card.getAttribute('data-preview');
    v.addEventListener('playing', function () { if (card.__want) card.classList.add('is-previewing'); });
    card.insertBefore(v, card.querySelector('.ssp-card_badge'));
    card.__v = v;
    return v;
  }
  function start(card) {
    card.__want = true;
    var p = getVideo(card).play(); if (p && p.catch) p.catch(function () {});
  }
  function stop(card) {
    card.__want = false; clearTimeout(card.__t);
    card.classList.remove('is-previewing');
    var v = card.__v; if (!v) return;
    v.pause();
    setTimeout(function () { if (!card.__want) { try { v.currentTime = 0; } catch (e) {} } }, 400);
  }
  function bind() {
    var cards = [].slice.call(document.querySelectorAll('.ssp-card[data-preview]:not([data-preview=""]), .ssp-card[data-preview-webp]:not([data-preview-webp=""])'));
    if (!cards.length || reduce) return;
    if (canHover) {
      // Desktop: play on hover, after a short pause so sweeping the mouse across the grid doesn't load every clip
      cards.forEach(function (card) {
        var host = card.closest('a') || card;
        host.addEventListener('mouseenter', function () { clearTimeout(card.__t); card.__t = setTimeout(function () { start(card); }, 120); });
        host.addEventListener('mouseleave', function () { stop(card); });
        host.addEventListener('focus', function () { start(card); });
        host.addEventListener('blur', function () { stop(card); });
      });
    } else if (!saveData && 'IntersectionObserver' in window) {
      // Touch screens: play the one card most in view, one at a time
      var current = null;
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { e.target.__ratio = e.intersectionRatio; });
        var best = null;
        cards.forEach(function (c) { if ((c.__ratio || 0) >= 0.75 && (!best || c.__ratio > best.__ratio)) best = c; });
        if (best !== current) { if (current) stop(current); current = best; if (best) start(best); }
      }, { threshold: [0, 0.25, 0.5, 0.75, 1] });
      cards.forEach(function (c) { io.observe(c); });
    }
    document.addEventListener('visibilitychange', function () { if (document.hidden) cards.forEach(stop); });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bind); else bind();
})();
</script>
                          </div>
                        </div>{% endpaginate %}
                      </section>
                    </div>
                    <a li-object:href="article.url" href="{{ article.url }}" class="button is-link is-icon w-inline-block">
                      <div>Read now</div>
                      <div class="icon-embed-xxsmall w-embed"><svg width="16" height="16" viewbox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M6 3L11 8L6 13" stroke="CurrentColor" stroke-width="1.5"></path>
                        </svg></div>
                    </a>
                  </div>
{% endfor %}
                </div>
              </div>
            </div>
          </div>
        </div> {% schema %} {
    "tag": "section",
    "name": "Blog posts",
    "class": "section_blog",
    "settings": [
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Short heading here"
        },
        {
            "id": "text_button_text",
            "type": "text",
            "label": "Button-Text",
            "default": "All Articles"
        },
        {
            "id": "url_button_link",
            "type": "url",
            "label": "Button-Link"
        },
        {
            "id": "article_article",
            "type": "article",
            "label": "Article"
        },
        {
            "id": "blog_blog",
            "type": "blog",
            "label": "Blog"
        },
        {
            "id": "post_limit_blog",
            "type": "range",
            "label": "Posts Blog",
            "min": 1,
            "max": 100,
            "step": 1,
            "default": 3
        }
    ],
    "presets": [
        {
            "name": "Blog posts",
            "category": "Liquify",
            "blocks": []
        }
    ]
} {% endschema %}