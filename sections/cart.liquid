<div class="cart_page-guard">
          <div class="div-block-23">
            <div class="headline-wrapper">
              <h2 id="w-node-_4ff72092-e0e6-d591-6af1-5b10f594a629-f594a625" class="heading-style-h2">
{{ section.settings.text_heading }}
</h2>
              <a href="{{ routes.root_url }}" li-object:href="routes.root_url" class="text-size-small text-style-link hide-mobile-landscape"></a>
            </div>
            {% if cart.item_count > 0 %}    <div li-if="cart.item_count > 0" class="cart_form-block w-form">
    
              {% form 'cart', cart, class: 'cart_grid-wrapper' %}
<div class="cart_table outline-solid-1">
                  <div class="cart_grid is-header w-hidden-tiny">
                    <div id="w-node-_4ff72092-e0e6-d591-6af1-5b10f594a632-f594a625" class="cart_table-header">
                      <p class="text-size-regular">
{{ section.settings.text_product }}
</p>
                    </div>
                    <div class="cart_table-header">
                      <p class="text-size-regular">
{{ section.settings.text_quantity }}
</p>
                    </div>
                    <div id="w-node-_4ff72092-e0e6-d591-6af1-5b10f594a638-f594a625" class="cart_table-header">
                      <p class="text-size-regular">
{{ section.settings.text_price }}
</p>
                    </div>
                  </div>
                  {% for item in cart.items %}    <div li-for="item in cart.items" class="cart_grid">
                                    
                    
                            <div id="w-node-_4ff72092-e0e6-d591-6af1-5b10f594a63c-f594a625" class="display-inlineflex">
                      <a href="{{ item.url }}" li-object:href="item.url" id="w-node-_4ff72092-e0e6-d591-6af1-5b10f594a63d-f594a625" class="w-inline-block"><img src="{{ item.image | image_url: width: 200 }}" li-object:src="item.image | image_url: width: 200" alt="" class="cart_image"></a>
                      <div class="cart_info-order">
                        <a href="{{ item.url }}" li-object:href="item.url" li-object="item.title" class="product-name-link">{{ item.title }}</a>
                        <div class="hide">
                          <p item="price" class="cart_price">$13</p>
                          <p item="original-price" class="cart_price away">$18</p>
                        </div>
                      </div>
                    </div>
                            
                    
                            <div id="w-node-_4ff72092-e0e6-d591-6af1-5b10f594a647-f594a625" class="cart_table-item anzahl">
                      <div class="cart_quantity-wrapper">
                        <div class="div-block-8">
                          <a data-cart-qty="-1" href="#" class="quantity-selector_mobile-_subtract w-inline-block"><img src="{{ '679fcfb0dade609036261e61_blockmine-substract.svg' | asset_url }}" loading="lazy" alt="" class="quantity-icon"></a><input min="1" type="number" name="updates[]" class="input_cart-quantity" value="{{ item.quantity }}">
                          <a data-cart-qty="1" href="#" class="quantity-selector_mobile w-inline-block"><img src="{{ '679fcfa0b2a6908facabf998_blockmine-add.svg' | asset_url }}" loading="lazy" alt="" class="quantity-icon"></a>
                        </div>
                      </div>
                      <a href="{{ item.url_to_remove }}" li-object:href="item.url_to_remove" class="text-size-tiny text-style-link text-align-center w-inline-block">
                        <div>
{{ section.settings.text_remove }}
</div>
                      </a>
                    </div>
                            
                    
                            <div id="w-node-_4ff72092-e0e6-d591-6af1-5b10f594a64f-f594a625" class="cart_price-info">
                      <div li-object="item.final_line_price | money" class="text-size-regular">{{ item.final_line_price | money }}</div>
                      {% if item.original_line_price > item.final_line_price %}    <div li-if="item.original_line_price > item.final_line_price">
    
                        <div li-object="item.original_line_price | money" class="text-size-regular text-style-strikethrough">{{ item.original_line_price | money }}</div>
                          </div>
{% endif %}
                    </div>
                            
                  
                        </div>
{% endfor %}
                </div>
                <div id="w-node-_4ff72092-e0e6-d591-6af1-5b10f594a655-f594a625" class="cart_wrapper-right">
                  <div id="w-node-_4ff72092-e0e6-d591-6af1-5b10f594a656-f594a625" class="cart_table outline-solid-1">
                    <div class="cart_grid is-header w-hidden-tiny">
                      <div id="w-node-_4ff72092-e0e6-d591-6af1-5b10f594a658-f594a625" class="cart_table-header">
                        <p class="text-size-regular">
{{ section.settings.text_summary }}
</p>
                      </div>
                    </div>
                    <div class="cart_content">
                      <div class="cart_wrapper">
                        <div class="cart_details-wrapper">
                          <div class="text-size-regular">
{{ section.settings.text_sum_inkl_vat }}
</div>
                          <div class="cart_details-price">
                            {% if cart.total_discounts > 0 %}    <div li-if="cart.total_discounts > 0">
    
                              <div li-object="cart.original_total_price | money" class="text-style-strikethrough">{{ cart.original_total_price | money }}</div>
                                </div>
{% endif %}
                            <div li-object="cart.total_price | money">{{ cart.total_price | money }}</div>
                          </div>
                        </div>
                        {% if cart.total_discounts > 0 %}    <div li-if="cart.total_discounts > 0" class="cart_details-wrapper">
    
                          <div class="text-size-regular">
{{ section.settings.text_discount }}
</div>
                          <div li-object="cart.total_discount | money">{{ cart.total_discount | money }}</div>
                            </div>
{% endif %}
                      </div>
                      <div class="cart_action"><input type="submit" data-wait="Please wait..." class="button w-button" value="Checkout" name="checkout"><input type="submit" data-wait="Please wait..." class="button is-outline w-button" value="Update cart"></div>
                    </div>
                  </div>
                  {% if cart.total_price >= 6000 %}    <div li-if="cart.total_price >= 6000" class="socks-guard">
    
                    <div class="free-socks">
                      <div class="headline-wrapper is-recs">
                        <div class="heading-style-h4">
{{ section.settings.text_socks_heading }}
</div>
                      </div>
                      <div class="product_list-wrapper swiper is-fp-carousel _w-dyn-list w-dyn-list">
                        <div li-for:inside="product in collections['socks'].products limit: 8" role="list" class="product_list swiper-wrapper w-dyn-items">
        {% for product in collections['socks'].products limit: 8 %}                            
                          
                            <div role="listitem" class="product_list-item swiper-slide w-dyn-item">
                            <div>
                              <script src="{{ 'li_custom.js' | asset_url }}" type="text/javascript"></script>
<div li-element="product-variant-container" class="product-item_component" x-data="handleVariant({{ product | json | escape }}, {{ product.options_by_name | json | escape }}, {{ product.selected_or_first_available_variant | json | escape }})" x-init="$nextTick(() => { activateVariants() })" @setbundleitem.window="updateBundleItem($event.detail.product, $event.detail.quantity)">
                                <div class="product-item_image-link">
                                  <a li-object:href="product.url" href="{{ product.url }}" class="product-item_image-wrapper w-inline-block"><img class="product-item_image" src="{{ product.featured_image | image_url: width: 900 }}" width="900" height="900" alt="{{ product.featured_image.alt }}" li-object:src="product.featured_image | image_url: width: 900" loading="lazy" li-object:alt="product.featured_image.alt" srcset="{{ product.featured_image | image_url: width: 1200 }}"><img class="product-item_image-hover" src="{{ product.metafields.custom.hover_product_image }}" width="900" height="900" alt="{{ product.featured_image.alt }}" li-object:src="product.metafields.custom.hover_product_image" loading="lazy" li-object:alt="product.featured_image.alt" srcset="{{ product.metafields.custom.hover_product_image | image_url: width: 900 }}"></a>
                                  <div class="product-item_tag_list">
                                    {% if product.available and product.tags contains 'Season 6' %}    <div li-if="product.available and product.tags contains 'Season 6'" class="product-item_tag is-new">
    NEW<br>    </div>
{% endif %}
                                    {% if product.selected_or_first_available_variant.available != true %}    <div li-if="product.selected_or_first_available_variant.available != true" class="product-item_tag">
    SOLD OUT    </div>
{% endif %}
                                    {% if product.compare_at_price_max > product.price %}    <div li-if="product.compare_at_price_max > product.price" class="product-item_tag is-red">
    Sale    </div>
{% endif %}
                                  </div>
                                </div>
                                <a li-object:href="product.url" href="{{ product.url }}" class="product-item_text-link w-inline-block">
                                  <div class="product-item_left">
                                    <div li-object="product.title" class="product-name-link">{{ product.title }}</div>
                                  </div>
                                  <div class="product-item_price">
                                    {% if product.compare_at_price > product.price %}    <div li-if="product.compare_at_price > product.price">
    
                                      <div li-object="product.compare_at_price | money" class="text-size-regular text-style-strikethrough text-style-muted">{{ product.compare_at_price | money }}</div>
                                        </div>
{% endif %}
                                    <div li-object="product.price | money" class="text-size-regular text-weight-bold">{{ product.price | money }}</div>
                                  </div>
                                </a>
                                <div class="margin-top-auto">
                                  <div class="product-item_form-wrapper">
                                    {% if product.available == true %}    <div li-if="product.available == true">
    
                                      <a li-element="add-to-cart" href="#" class="button max-width-full w-button" @click="addToCart($event, true)" :disabled="!addToCartButton">Add to Cart</a>
                                        </div>
{% endif %}
                                    {% if product.available != true %}    <div li-if="product.available != true">
    
                                      <a href="#" class="button is-secondary pointer-events-off max-width-full w-button">Not in Stock</a>
                                        </div>
{% endif %}
                                  </div>
                                </div>
                                <div class="w-embed w-script">
                                  <script>
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.product-item_image, .product-item_image-hover').forEach(function(img) {
    img.setAttribute('sizes', '(max-width: 768px) 50vw, 25vw');
  });
});
</script>
                                </div>
                              </div>
                            </div>
                          </div>
                            
                        
                    {% endfor %}    </div>
                        <div class="hide w-dyn-empty">
                          <div>No items found.</div>
                        </div>
                      </div>
                      <div class="w-embed">
                        <div class="fp-controls">
                          <button class="fp-prev" aria-label="Previous">
                            <svg width="18" height="18" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <path d="M15 18L9 12L15 6" fill="none"></path>
                            </svg>
                          </button>
                          <div class="fp-pagination"></div>
                          <button class="fp-next" aria-label="Next">
                            <svg width="18" height="18" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <path d="M9 18L15 12L9 6" fill="none"></path>
                            </svg>
                          </button>
                        </div>
                      </div>
                    </div>
                      </div>
{% endif %}
                </div>
              {% endform %}
              <div class="w-form-done">
                <div>Thank you! Your submission has been received!</div>
              </div>
              <div class="w-form-fail">
                <div>Oops! Something went wrong while submitting the form.</div>
              </div>
                </div>
{% endif %}
            {% if cart.item_count == 0 %}    <div li-if="cart.item_count == 0" class="cart_empty outline-solid-1">
    
              <div>
{{ section.settings.text_cart_empty }}
</div>
              <a href="{{ routes.root_url }}" li-object:href="routes.root_url" class="button w-button">Shop Now</a>
                </div>
{% endif %}
          </div>
