{% for block in section.blocks %}
    {% if block.type == "images" %}
                    <div li-block="images" class="div-block-4">
                                    
          
                                    <div li-object:style="block.settings.image_pos_x | prepend: 'object-position: ' | append: '% ' | append: block.settings.image_pos_y | append: '%'" class="content-grid_item" style="{{ block.settings.image_pos_x | prepend: 'object-position: ' | append: '% ' | append: block.settings.image_pos_y | append: '%' }}">{% if block.settings.image_image %}
{{ block.settings.image_image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'content-grid_image' }}
{% else %}
<img src="https://d3e54v103j8qbb.cloudfront.net/plugins/Basic/assets/placeholder.60f9b1840c.svg" loading="lazy" alt="" class="content-grid_image">
{% endif %}
            <div class="content-grid_overlay"></div>
            <div class="content-grid_hover">
              <a href="{{ block.settings.url_link_url }}" class="content-grid_text-link w-inline-block"> {{ block.settings.text_link_text }} </a>
              <a href="{{ block.settings.url_button_url }}" class="content-grid_cta w-button"> {{ block.settings.text_button_text }} </a>
            </div>
          </div>
                                    
          
                                    
                                    
        
                            </div>
            {% endif %}
{% endfor %} {% schema %} {
    "tag": "div",
    "name": "Content Grid Home",
    "class": "div-block-2",
    "blocks": [
        {
            "name": "images",
            "type": "images",
            "settings": [
                {
                    "id": "image_image",
                    "type": "image_picker",
                    "label": "Image"
                },
                {
                    "id": "url_link_url",
                    "type": "url",
                    "label": "Link URL"
                },
                {
                    "id": "text_link_text",
                    "type": "text",
                    "label": "Link Text",
                    "default": "Lorem Ipsum"
                },
                {
                    "id": "url_button_url",
                    "type": "url",
                    "label": "Button Url"
                },
                {
                    "id": "text_button_text",
                    "type": "text",
                    "label": "Button Text",
                    "default": "Button Text"
                },
                {
                    "type": "range",
                    "id": "image_pos_x",
                    "label": "Horizontal position",
                    "min": 0,
                    "max": 100,
                    "step": 5,
                    "unit": "%",
                    "default": 50
                },
                {
                    "type": "range",
                    "id": "image_pos_y",
                    "label": "Vertical position",
                    "min": 0,
                    "max": 100,
                    "step": 5,
                    "unit": "%",
                    "default": 50
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Content Grid Home",
            "category": "Liquify",
            "blocks": [
                {
                    "type": "images"
                }
            ]
        }
    ]
} {% endschema %}