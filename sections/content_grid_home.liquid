{% for block in section.blocks %}
    {% if block.type == "images" %}
                    <div li-block="images" class="content-grid_col">
                                    
          
                                    <div li-object:style="block.settings.image_pos_x | prepend: '--img-x: ' | append: '%; --img-y: ' | append: block.settings.image_pos_y | append: '%'" class="content-grid_item" style="{{ block.settings.image_pos_x | prepend: '--img-x: ' | append: '%; --img-y: ' | append: block.settings.image_pos_y | append: '%' }}">
            <a href="{{ block.settings.url_image_link_url }}" class="content-grid_cover-link w-inline-block"> </a>{% if block.settings.image_image %}
{{ block.settings.image_image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'content-grid_image' }}
{% else %}
<img src="https://d3e54v103j8qbb.cloudfront.net/plugins/Basic/assets/placeholder.60f9b1840c.svg" loading="lazy" alt="" class="content-grid_image">
{% endif %}
            <div class="w-embed"><video class="content-grid_video" autoplay="" muted="" loop="" playsinline="" preload="metadata" poster="{% if block.settings.image_image %}{{ block.settings.image_image | image_url: width: 1000 }}{% endif %}" src="{% if block.settings.video_mp4 != blank %}{{ block.settings.video_mp4 }}{% else %}data:,{% endif %}" style="{% if block.settings.video_mp4 == blank %}display: none;{% endif %}"></video></div>
            <div class="content-grid_overlay"></div>
            <div class="content-grid_hover">
              <a href="{{ block.settings.url_link_url }}" class="content-grid_text-link w-inline-block"> {{ block.settings.text_link_text }} </a>
              <a href="{{ block.settings.url_button_url }}" class="content-grid_cta w-button"> {{ block.settings.text_button_text }} </a>
            </div>
          </div>
                                    
          
                                    
                                    
        
                            </div>
            {% endif %}
{% endfor %}
        <a li-object:href="section.settings.grid_url" href="{{ section.settings.grid_url }}" class="content-grid_group-link w-inline-block"></a>
        <div class="content-grid_group-hover">
          <a li-object:href="section.settings.grid_url" li-object="section.settings.grid_text" href="{{ section.settings.grid_url }}" class="content-grid_text-link w-inline-block">{{ section.settings.grid_text }}</a>
          <a li-object="section.settings.grid_cta" li-object:href="section.settings.grid_url" href="{{ section.settings.grid_url }}" class="content-grid_cta w-button">{{ section.settings.grid_cta }}</a>
        </div>
        
        <div class="w-embed">
          <style>
#shopify-section-{{ section.id }} {
  position: relative;
  display: grid;
  place-items: stretch;
  grid-template-columns: repeat({{ section.settings.cols_d }}, 1fr);
  gap: {{ section.settings.gap }}px;
}
#shopify-section-{{ section.id }} > .w-embed {
  display: none;
}
#shopify-section-{{ section.id }} .content-grid_item {
{% if section.settings.lock_ratio %}
  aspect-ratio: {{ section.settings.ratio }};
  height: auto;
{% else %}
  aspect-ratio: auto;
  height: {{ section.settings.h_d }}vh;
{% endif %}
}
{% for block in section.blocks %}
#shopify-section-{{ section.id }} > .content-grid_col:nth-child({{ forloop.index }}) {
  display: {% if block.settings.hide_desktop %}none{% else %}block{% endif %};
  grid-column: {{ block.settings.span_d }};
}
{% endfor %}
#shopify-section-{{ section.id }} .content-grid_hover {
  display: {% if section.settings.group_link %}none{% else %}flex{% endif %};
}
#shopify-section-{{ section.id }} .content-grid_group-link,
#shopify-section-{{ section.id }} .content-grid_group-hover {
  display: {% if section.settings.group_link %}flex{% else %}none{% endif %};
}
#shopify-section-{{ section.id }}:hover .content-grid_overlay {
  opacity: {% if section.settings.group_link %}1{% else %}0{% endif %};
}
#shopify-section-{{ section.id }}:hover .content-grid_group-hover {
  opacity: 1;
}
#shopify-section-{{ section.id }} .content-grid_item:hover .content-grid_overlay,
#shopify-section-{{ section.id }} .content-grid_item:hover .content-grid_hover {
  opacity: 1;
}
@media (hover: none), (pointer: coarse) {
  #shopify-section-{{ section.id }} .content-grid_overlay,
  #shopify-section-{{ section.id }} .content-grid_hover,
  #shopify-section-{{ section.id }} .content-grid_group-hover {
    opacity: 1;
  }
}
@media screen and (max-width: 767px) {
  #shopify-section-{{ section.id }} {
    grid-template-columns: repeat({{ section.settings.cols_m }}, 1fr);
  }
  #shopify-section-{{ section.id }} .content-grid_item {
{% if section.settings.lock_ratio %}
    height: auto;
{% else %}
    height: {{ section.settings.h_m }}vh;
{% endif %}
  }
{% for block in section.blocks %}
  #shopify-section-{{ section.id }} > .content-grid_col:nth-child({{ forloop.index }}) {
    display: {% if block.settings.hide_mobile %}none{% else %}block{% endif %};
    grid-column: {{ block.settings.span_m }};
  }
{% endfor %}
}
</style>
        </div> {% schema %} {
    "tag": "div",
    "name": "Content Grid Home",
    "class": "div-block-2",
    "blocks": [
        {
            "name": "images",
            "type": "images",
            "settings": [
                {
                    "id": "url_image_link_url",
                    "type": "url",
                    "label": "Image Link URL"
                },
                {
                    "id": "image_image",
                    "type": "image_picker",
                    "label": "Image"
                },
                {
                    "id": "url_link_url",
                    "type": "url",
                    "label": "Link URL"
                },
                {
                    "id": "text_link_text",
                    "type": "text",
                    "label": "Link Text",
                    "default": "Lorem Ipsum"
                },
                {
                    "id": "url_button_url",
                    "type": "url",
                    "label": "Button Url"
                },
                {
                    "id": "text_button_text",
                    "type": "text",
                    "label": "Button Text",
                    "default": "Button Text"
                },
                {
                    "type": "range",
                    "id": "image_pos_x",
                    "label": "Horizontal position",
                    "min": 0,
                    "max": 100,
                    "step": 5,
                    "unit": "%",
                    "default": 50
                },
                {
                    "type": "range",
                    "id": "image_pos_y",
                    "label": "Vertical position",
                    "min": 0,
                    "max": 100,
                    "step": 5,
                    "unit": "%",
                    "default": 50
                },
                {
                    "type": "header",
                    "content": "Visibility and width"
                },
                {
                    "type": "checkbox",
                    "id": "hide_desktop",
                    "label": "Hide on desktop",
                    "default": false
                },
                {
                    "type": "checkbox",
                    "id": "hide_mobile",
                    "label": "Hide on mobile",
                    "default": false
                },
                {
                    "type": "select",
                    "id": "span_d",
                    "label": "Width - desktop",
                    "options": [
                        {
                            "value": "auto",
                            "label": "1 column"
                        },
                        {
                            "value": "span 2",
                            "label": "2 columns"
                        },
                        {
                            "value": "span 3",
                            "label": "3 columns"
                        },
                        {
                            "value": "1 \/ -1",
                            "label": "Full row"
                        }
                    ],
                    "default": "auto"
                },
                {
                    "type": "select",
                    "id": "span_m",
                    "label": "Width - mobile",
                    "options": [
                        {
                            "value": "auto",
                            "label": "1 column"
                        },
                        {
                            "value": "span 2",
                            "label": "2 columns"
                        },
                        {
                            "value": "1 \/ -1",
                            "label": "Full row"
                        }
                    ],
                    "default": "auto"
                },
                {
                    "type": "header",
                    "content": "Animation (optional)"
                },
                {
                    "type": "text",
                    "id": "video_webm",
                    "label": "WebM URL"
                },
                {
                    "type": "text",
                    "id": "video_mp4",
                    "label": "MP4 URL"
                }
            ]
        }
    ],
    "settings": [
        {
            "type": "header",
            "content": "Layout"
        },
        {
            "type": "select",
            "id": "cols_d",
            "label": "Images per row - desktop",
            "options": [
                {
                    "value": "1",
                    "label": "1"
                },
                {
                    "value": "2",
                    "label": "2"
                },
                {
                    "value": "3",
                    "label": "3"
                },
                {
                    "value": "4",
                    "label": "4"
                },
                {
                    "value": "5",
                    "label": "5"
                },
                {
                    "value": "6",
                    "label": "6"
                }
            ],
            "default": "3"
        },
        {
            "type": "select",
            "id": "cols_m",
            "label": "Images per row - mobile",
            "options": [
                {
                    "value": "1",
                    "label": "1"
                },
                {
                    "value": "2",
                    "label": "2"
                },
                {
                    "value": "3",
                    "label": "3"
                }
            ],
            "default": "2"
        },
        {
