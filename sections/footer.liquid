          <script>
(function () {
  var mq = window.matchMedia('(max-width: 767px)');
  function syncHeaders() {
    document.querySelectorAll('.footer_link-header').forEach(function (h) {
      if (mq.matches) {
        h.setAttribute('tabindex', '0');
        h.setAttribute('role', 'button');
        if (!h.hasAttribute('aria-expanded')) h.setAttribute('aria-expanded', 'false');
      } else {
        h.removeAttribute('tabindex');
        h.removeAttribute('role');
        h.removeAttribute('aria-expanded');
      }
    });
  }
  document.addEventListener('click', function (e) {
    var header = e.target.closest('.footer_link-header');
    if (!header || !mq.matches) return;
    var col = header.closest('.footer_link-column');
    if (!col) return;
    col.classList.toggle('is-open');
    header.setAttribute('aria-expanded', col.classList.contains('is-open') ? 'true' : 'false');
  });
  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    var header = e.target.closest('.footer_link-header');
    if (!header || !mq.matches) return;
    e.preventDefault();
    header.click();
  });
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', syncHeaders);
  } else {
    syncHeaders();
  }
  mq.addEventListener('change', syncHeaders);
  document.addEventListener('shopify:section:load', syncHeaders);
})();
</script>
          <style>
@media screen and (max-width: 767px) {
  .footer_link-header { cursor: pointer; }
  .footer_link-chevron { transition: transform .25s ease; }
  .footer_link-column.is-open .footer_link-chevron { transform: rotate(180deg); }
  .footer_sublink-list {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows .3s ease;
    overflow: hidden;
    padding: 0;
    row-gap: 0;
  }
  .footer_link-column.is-open .footer_sublink-list { grid-template-rows: 1fr; }
  .footer_sublink-inner {
    overflow: hidden;
    min-height: 0;
    padding: .5rem;
  }
}
</style>
