                          <path d="M1 14h1.2v4H1zM3.2 12h1.2v6H3.2zM5.4 11h1.2v7H5.4zM7.6 10h1.2v8H7.6zM9.8 8h1.2v10H9.8zM12 7.2A6 6 0 0 1 14.6 6.6a6 6 0 0 1 5.9 5 3.4 3.4 0 0 1-.5 6.4H12z"></path>
