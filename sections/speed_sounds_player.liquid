.ssp:-webkit-full-screen .ssp_stage { flex: 1; aspect-ratio: auto; }
/* Small screens */
@media (max-width: 767px) {
  .ssp { --ssp-pad: 1rem; }
  .ssp_hide-sm { display: none !important; }
  .ssp_controls { gap: .35rem; }
}
@media (hover: none) { .ssp_vol { display: none; } }
</style>
