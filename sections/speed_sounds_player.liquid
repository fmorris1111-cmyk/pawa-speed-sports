          {% assign ssp_cur_genres = '|' %}
          {% for g in article.metafields.custom.genres.value %}{% assign ssp_g = g | downcase | strip %}{% assign ssp_cur_genres = ssp_cur_genres | append: ssp_g | append: '|' %}{% endfor %}
          {% assign ssp_keys = '' %}
          {% for other in blog.articles %}
          {% assign ssp_idx = forloop.index0 | plus: 1000 %}
          {% if other.id == article.id or other.metafields.custom.video_url == blank %}{% continue %}{% endif %}
          {% assign ssp_score = 0 %}
          {% for a in other.metafields.custom.artists.value %}{% assign ssp_t = '|' | append: a.system.handle | append: '|' %}{% if ssp_cur_artists contains ssp_t %}{% assign ssp_score = ssp_score | plus: 3 %}{% endif %}{% endfor %}
          {% for g in other.metafields.custom.genres.value %}{% assign ssp_g = g | downcase | strip %}{% assign ssp_t = '|' | append: ssp_g | append: '|' %}{% if ssp_cur_genres contains ssp_t %}{% assign ssp_score = ssp_score | plus: 1 %}{% endif %}{% endfor %}
          {% assign ssp_inv = 900 | minus: ssp_score %}
