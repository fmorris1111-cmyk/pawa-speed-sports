          <div class="w-embed">
            <div class="ssp" data-ssp-player="" data-src="{{ article.metafields.custom.video_url }}" data-title="{{ article.title | escape }}" data-artist="Speed Sounds" data-poster="{% if article.image %}{{ article.image | image_url: width: 1600 }}{% endif %}">
              <div class="ssp_stage">
                <video class="ssp_video" playsinline="" preload="none"></video>
                <div class="ssp_audio-card">
                  <div class="ssp_audio-card-bg"></div>
                  <div class="ssp_audio-card-text">
                    <div class="ssp_audio-label">Audio only</div>
                    <div class="ssp_audio-title">{{ article.title | escape }}</div>
                  </div>
                </div>
                <button type="button" class="ssp_big-play" aria-label="Play"></button>
                <div class="ssp_spinner" aria-hidden="true"></div>
                <div class="ssp_error" hidden=""></div>
              </div>
              <div class="ssp_controls">
                <button type="button" class="ssp_btn" data-ssp="play" aria-label="Play"></button>
                <button type="button" class="ssp_btn ssp_hide-sm" data-ssp="back" aria-label="Back 10 seconds"></button>
                <button type="button" class="ssp_btn ssp_hide-sm" data-ssp="fwd" aria-label="Forward 10 seconds"></button>
                <span class="ssp_time ssp_time-cur">0:00</span>
                <div class="ssp_bar" role="slider" tabindex="0" aria-label="Seek" aria-valuemin="0" aria-valuemax="0" aria-valuenow="0">
