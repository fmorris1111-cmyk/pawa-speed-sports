.ssp_audio-card { position: absolute; inset: 0; display: none; align-items: center; justify-content: center; text-align: center; color: #fff; }
.ssp.is-audio .ssp_audio-card { display: flex; }
.ssp_audio-card-bg { position: absolute; inset: -40px; background: #111 center / cover no-repeat; filter: blur(24px) brightness(.45); }
.ssp_audio-card-text { position: relative; padding: 0 1.5rem; max-width: 40rem; }
.ssp_audio-label { opacity: .7; margin-bottom: .75rem; }
.ssp_audio-title { font-family: 'Nimbussanl Bol', Arial, sans-serif; font-size: clamp(1.25rem, 3vw, 2.25rem); line-height: 1; }
.ssp.is-audio .ssp_big-play { background: rgba(255,255,255,.9); }
.ssp.is-audio.is-playing .ssp_big-play { opacity: 0; }
/* Spinner + error */
.ssp_spinner { position: absolute; left: 50%; top: 50%; width: 2.5rem; height: 2.5rem; margin: -1.25rem 0 0 -1.25rem;
  border: 3px solid rgba(255,255,255,.25); border-top-color: #fff; border-radius: 50%; animation: ssp-spin .8s linear infinite; display: none; pointer-events: none; }
.ssp.is-waiting .ssp_spinner { display: block; }
.ssp.is-waiting .ssp_big-play { opacity: 0; }
@keyframes ssp-spin { to { transform: rotate(360deg); } }
.ssp_error { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; padding: 1rem; color: #fff; background: rgba(0,0,0,.8); text-align: center; }
.ssp_error[hidden] { display: none; }
/* Controls */
.ssp_controls { display: flex; align-items: center; gap: .5rem; padding: .5rem var(--ssp-pad); }
.ssp_btn, .ssp_quality {
  flex: none; height: 2rem; min-width: 2rem; padding: 0 .5rem; border: 0; border-radius: 4px;
  background: var(--ssp-chip); color: var(--ssp-fg); cursor: pointer;
  display: inline-flex; align-items: center; justify-content: center; transition: background-color .2s;
  font: inherit; text-transform: uppercase;
}
.ssp_btn:hover, .ssp_quality:hover, .ssp_btn[aria-pressed="true"] { background: var(--ssp-chip-hover); }
.ssp_btn[hidden], .ssp_quality[hidden] { display: none; }
.ssp_quality { appearance: none; -webkit-appearance: none; padding: 0 .6rem; }
.ssp_quality:disabled { opacity: .4; cursor: default; }
.ssp :focus-visible { outline: 2px solid #2d62ff; outline-offset: 2px; }
.ssp_time { flex: none; font-variant-numeric: tabular-nums; min-width: 3.2em; text-align: center; }
/* Seek bar */
.ssp_bar { position: relative; flex: 1; height: 2rem; cursor: pointer; touch-action: none; min-width: 4rem; }
.ssp_bar-track { position: absolute; left: 0; right: 0; top: 50%; height: 4px; margin-top: -2px; background: var(--ssp-line); }
.ssp_bar-buffered, .ssp_bar-progress { position: absolute; left: 0; top: 0; bottom: 0; width: 0; }
.ssp_bar-buffered { background: #bdbdbd; }
.ssp_bar-progress { background: var(--ssp-fg); }
.ssp_bar-thumb { position: absolute; top: 50%; left: 0; width: 12px; height: 12px; margin: -6px 0 0 -6px; border-radius: 50%; background: var(--ssp-fg); transform: scale(0); transition: transform .15s; }
.ssp_bar:hover .ssp_bar-thumb, .ssp_bar:focus-visible .ssp_bar-thumb, .ssp.is-scrubbing .ssp_bar-thumb { transform: scale(1); }
.ssp_bar-tip { position: absolute; bottom: calc(100% + 4px); left: 0; transform: translateX(-50%); background: #000; color: #fff;
  padding: .3rem .5rem; border-radius: 4px; white-space: nowrap; pointer-events: none; opacity: 0; transition: opacity .1s; max-width: 18rem; overflow: hidden; text-overflow: ellipsis; }
.ssp_bar.is-hover .ssp_bar-tip, .ssp.is-scrubbing .ssp_bar-tip { opacity: 1; }
/* Volume */
.ssp_vol-wrap { display: flex; align-items: center; gap: .35rem; flex: none; }
.ssp_vol { width: 4.5rem; accent-color: var(--ssp-fg); cursor: pointer; }
/* Fullscreen */
.ssp:fullscreen { --ssp-bg: #000; --ssp-fg: #fff; --ssp-chip: #222; --ssp-chip-hover: #444; --ssp-line: #333; display: flex; flex-direction: column; }
