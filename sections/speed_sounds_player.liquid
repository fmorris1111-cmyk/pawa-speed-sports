.ssp *, .ssp *::before, .ssp *::after { box-sizing: border-box; }
.ssp svg { width: 16px; height: 16px; fill: currentColor; display: block; }
/* Stage */
.ssp_stage { position: relative; width: 100%; aspect-ratio: 16 / 9; background: #000; overflow: hidden; cursor: pointer; }
.ssp_video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; background: #000; }
.ssp_big-play {
