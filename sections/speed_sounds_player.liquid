              <script>
(function () {
  if (window.__sspShare) return; window.__sspShare = true;
  function copy(text) {
    if (navigator.clipboard && window.isSecureContext) return navigator.clipboard.writeText(text);
    return new Promise(function (res, rej) {
      var t = document.createElement('textarea'); t.value = text; t.setAttribute('readonly', '');
      t.style.position = 'fixed'; t.style.opacity = '0'; document.body.appendChild(t); t.select();
      try { document.execCommand('copy') ? res() : rej(); } catch (e) { rej(e); }
      document.body.removeChild(t);
    });
  }
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-ssp-share]'); if (!btn) return;
    e.preventDefault();
    var url = btn.getAttribute('data-url') || location.href.split('?')[0];
    var title = btn.getAttribute('data-title') || document.title;
    var touch = window.matchMedia && matchMedia('(pointer: coarse)').matches;
    if (navigator.share && touch) { navigator.share({ title: title, url: url }).catch(function () {}); return; }
    var label = btn.querySelector('.ssp-share-label');
    copy(url).then(function () {
      btn.classList.add('is-copied'); if (label) label.textContent = 'Link copied';
      clearTimeout(btn.__t); btn.__t = setTimeout(function () { btn.classList.remove('is-copied'); if (label) label.textContent = 'Share'; }, 1800);
    }, function () { window.prompt('Copy this link:', url); });
  });
})();
</script>
