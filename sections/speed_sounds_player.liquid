                    <div class="ssp_bar-buffered"></div>
                    <div class="ssp_bar-progress"></div>
                  </div>
                  <div class="ssp_bar-thumb"></div>
                  <div class="ssp_bar-tip"></div>
                </div>
                <span class="ssp_time ssp_time-dur">--:--</span>
                <div class="ssp_vol-wrap">
                  <button type="button" class="ssp_btn" data-ssp="mute" aria-label="Mute"></button>
