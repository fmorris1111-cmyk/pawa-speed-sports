.ssp_big-play svg { width: 28px; height: 28px; }
.ssp_big-play:hover { transform: translate(-50%, -50%) scale(1.06); }
.ssp.is-started .ssp_big-play { opacity: 0; pointer-events: none; }
.ssp.is-started:not(.is-playing) .ssp_big-play { opacity: 1; pointer-events: auto; }
