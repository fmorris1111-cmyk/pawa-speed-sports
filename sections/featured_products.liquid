<div class="padding_product-recs">
          <div class="product-recs_container">
            <div class="product_component">
              <div id="w-node-f727b04f-0fb7-b1ec-5db9-c7264e4cbfb1-4e4cbfad" class="product_heading-wrapper">
                <div class="product_heading">
                  <div class="max-width-large">
                    <h2 class="heading-style-h2">
{{ section.settings.text_heading }}
</h2>
                  </div>
                </div>
                <div class="product_button-row">
                  <a href="{{ section.settings.url_button_link }}" class="button w-button"> {{ section.settings.text_button_text }} </a>
                </div>
              </div>
              <div class="product_list-col">
                <div class="product_list-wrapper swiper is-fp-carousel _w-dyn-list w-dyn-list">
                  <div role="list" class="product_list swiper-wrapper w-dyn-items">
                    {% for product in section.settings.collection_collection.products limit: section.settings.collection_collection_limit %}
<div role="listitem" class="product_list-item swiper-slide w-dyn-item">
    
                      
    {% render 'product_item', product: product %}
    
                    
</div>
{% endfor %}
                  </div>
                  <div class="hide w-dyn-empty">
                    <div>No items found.</div>
                  </div>
                </div>
                <div class="w-embed">
                  <div class="fp-controls">
                    <button class="fp-prev" aria-label="Previous">
                      <svg width="18" height="18" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M15 18L9 12L15 6" fill="none"></path>
                      </svg>
                    </button>
                    <div class="fp-pagination"></div>
                    <button class="fp-next" aria-label="Next">
                      <svg width="18" height="18" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M9 18L15 12L9 6" fill="none"></path>
                      </svg>
                    </button>
                  </div>
                </div>
              </div>
              <div class="product_button-row mobile_portrait">
                <a href="{{ section.settings.url_button_link }}" class="button w-button"> {{ section.settings.text_button_text }} </a>
              </div>
              <div class="product_media">{% if section.settings.image_media_image %}
{{ section.settings.image_media_image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'product_media-image' }}
{% else %}
<img src="https://d3e54v103j8qbb.cloudfront.net/plugins/Basic/assets/placeholder.60f9b1840c.svg" loading="lazy" alt="" class="product_media-image">
{% endif %}
                <div class="w-embed"><video class="product_media-video" autoplay="" muted="" loop="" playsinline="" preload="metadata" poster="{% if section.settings.image_media_image %}{{ section.settings.image_media_image | image_url: width: 1200 }}{% endif %}" src="{% if section.settings.media_mp4 != blank %}{{ section.settings.media_mp4 }}{% else %}data:,{% endif %}" style="{% if section.settings.media_mp4 == blank %}display: none;{% endif %}"></video></div>
              </div>
            </div>
          </div>
        </div>
        
        <div class="w-embed">
          <style>
#shopify-section-{{ section.id }} .product_component {
  display: grid;
{% if section.settings.show_media %}
  grid-template-columns: {{ section.settings.media_w }}% 1fr;
  grid-template-areas: "head head" "media list";
  column-gap: {{ section.settings.media_gap }}px;
{% else %}
  grid-template-columns: 1fr;
  grid-template-areas: "head" "list";
{% endif %}
}
#shopify-section-{{ section.id }} .product_heading-wrapper { grid-area: head; }
#shopify-section-{{ section.id }} .product_list-col { grid-area: list; min-width: 0; }
#shopify-section-{{ section.id }} .product_media {
  grid-area: media;
  min-width: 0;
  display: {% if section.settings.show_media %}block{% else %}none{% endif %};
  position: relative;
}
#shopify-section-{{ section.id }} .product_media-image,
#shopify-section-{{ section.id }} .product_media-video {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
}
#shopify-section-{{ section.id }} .product_media-video {
  position: absolute;
  inset: 0;
}
@media screen and (max-width: 767px) {
  #shopify-section-{{ section.id }} .product_component {
    display: flex;
    flex-direction: column;
  }
  #shopify-section-{{ section.id }} .product_media {
    height: auto;
  }
  #shopify-section-{{ section.id }} .product_media-image,
  #shopify-section-{{ section.id }} .product_media-video {
    height: auto;
    position: static;
  }
}
</style>
        </div> {% schema %} {
    "tag": "section",
    "name": "Featured products",
    "class": "section_product",
    "settings": [
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Short heading here"
        },
        {
            "id": "url_button_link",
            "type": "url",
            "label": "Button-Link"
        },
        {
            "id": "text_button_text",
            "type": "text",
            "label": "Button-Text",
            "default": "All products"
        },
        {
            "id": "collection_collection",
            "type": "collection",
            "label": "Collection"
        },
        {
            "type": "range",
            "id": "collection_collection_limit",
            "min": 1,
            "max": 99,
            "step": 1,
            "label": "Limit: Collection",
            "default": 6
        },
        {
            "id": "image_media_image",
            "type": "image_picker",
            "label": "Media Image"
        },
        {
            "type": "header",
            "content": "Media panel"
        },
        {
            "type": "checkbox",
            "id": "show_media",
            "label": "Show image \/ video panel",
            "default": false
        },
        {
            "type": "range",
            "id": "media_w",
            "label": "Panel width - desktop",
            "min": 15,
            "max": 50,
            "step": 1,
            "unit": "%",
            "default": 28
        },
        {
            "type": "range",
            "id": "media_gap",
            "label": "Gap",
            "min": 0,
            "max": 48,
            "step": 2,
            "unit": "px",
            "default": 16
        },
        {
            "type": "text",
            "id": "media_webm",
            "label": "WebM URL"
        },
        {
            "type": "text",
            "id": "media_mp4",
            "label": "MP4 URL"
        }
    ],
    "presets": [
        {
            "name": "Featured products",
            "category": "Liquify",
            "blocks": []
        }
    ]
} {% endschema %}