        <div class="w-embed">
          <style>
#shopify-section-{{ section.id }} .ticker_row {
  --count: {{ section.settings.count_d }};
  --step-ms: {{ section.settings.step_ms }};
  --slow-ms: {{ section.settings.slow_ms }};
  --travel-ms: {{ section.settings.travel_ms }};
  --resume-ms: {{ section.settings.resume_ms }};
  --ease: {{ section.settings.ease }};
  --lead: {{ section.settings.lead }};
  --tail: {{ section.settings.tail }};
  --rand: {{ section.settings.rand }};
  --soft: {{ section.settings.soft }};
  --lift: {{ section.settings.lift }};
  --grow: {{ section.settings.grow }};
  --hover-on: {% if section.settings.hover_on %}1{% else %}0{% endif %};
  --c-off: {{ section.settings.colour_off }};
  --c-on: {{ section.settings.colour_on }};
  display: grid;
  grid-template-columns: repeat(var(--count), 1fr);
  align-items: center;
  gap: {{ section.settings.gap }}px;
  padding: {{ section.settings.pad }}px;
  background: {{ section.settings.bg }};
  touch-action: pan-y;
}
#shopify-section-{{ section.id }} .ticker_item {
  position: relative;
  min-width: 0;
  aspect-ratio: 292 / 304;
  transform: translateY(calc(-1px * var(--lift, 0) * var(--t, 0)))
             scale(calc(1 + (var(--grow, 0) / 100) * var(--t, 0)));
}
#shopify-section-{{ section.id }} .ticker_item svg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
}
#shopify-section-{{ section.id }} .ticker_off { color: var(--c-off); }
#shopify-section-{{ section.id }} .ticker_on  { color: var(--c-on); }
@media screen and (max-width: 767px) {
  #shopify-section-{{ section.id }} .ticker_row {
    --count: {{ section.settings.count_m }};
  }
}
</style>
