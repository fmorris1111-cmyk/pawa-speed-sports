    var st = q('.nav_stock-toggle');
    if (st) st.classList.toggle('is-active', p.get('filter.v.availability') === '1');
    var r = q('.nav_reset'); if (r) r.classList.toggle('is-inactive', !any);
    var a = q('.nav_applied');
    if (a) a.style.display = a.querySelector('.nav_applied-chip') ? '' : 'none';
  }
  function prime() {
    var fd = q('.nav_filter-drawer'), sd = q('.nav_sort-drawer');
    if (fd) gsap.set(fd, { height: 0, overflow: 'hidden' });
    if (sd) gsap.set(sd, { height: 0, overflow: 'hidden' });
    gsap.set(qa('.nav_filter-panel'), { display: 'none' });
    markState();
  }
  function closeFilter() {
    var fd = q('.nav_filter-drawer'); if (!fd || openKey === null) return;
    openKey = null;
    var fb = q('.nav_filter-bar'); if (fb) fb.classList.remove('is-open');
    qa('.nav_filter-btn.is-open').forEach(function (b) { b.classList.remove('is-open'); });
    gsap.killTweensOf(fd);
    gsap.to(fd, { height: 0, duration: .3, ease: 'power2.inOut',
      onComplete: function () { gsap.set(qa('.nav_filter-panel'), { display: 'none' }); } });
  }
  function closeSort() {
    var sd = q('.nav_sort-drawer'), sb = q('.nav_sort-btn');
    if (!sd || !sb || !sb.classList.contains('is-open')) return;
    sb.classList.remove('is-open');
    var sbar = q('.nav_sort-bar'); if (sbar) sbar.classList.remove('is-open');
    gsap.killTweensOf(sd);
    gsap.to(sd, { height: 0, duration: .3, ease: 'power2.inOut' });
  }
  function openFilter(key, animate) {
    var fd = q('.nav_filter-drawer'), panel = q('[data-filter-panel="' + key + '"]');
    if (!fd || !panel) return;
    closeSort();
    openKey = key;
    var fb = q('.nav_filter-bar'); if (fb) fb.classList.add('is-open');
    qa('.nav_filter-btn').forEach(function (b) {
      b.classList.toggle('is-open', b.getAttribute('data-filter') === key);
    });
    gsap.set(qa('.nav_filter-panel'), { display: 'none' });
    gsap.set(panel, { display: 'flex' });
    gsap.killTweensOf(fd);
    if (animate === false) gsap.set(fd, { height: panel.offsetHeight });
    else gsap.to(fd, { height: panel.offsetHeight, duration: .4, ease: 'power2.out' });
  }
  function go(url) {
    if (busy || !url || url === '#') return;
    busy = true;
    var keep = openKey;
    fetch(url).then(function (r) { return r.text(); }).then(function (html) {
      var doc = new DOMParser().parseFromString(html, 'text/html');
      var ng = doc.querySelector('.filter_layout'), cg = q('.filter_layout');
      if (ng && cg) cg.replaceWith(ng);
      var nc = doc.querySelector('.nav_filter-col'), cc = q('.nav_filter-col');
      if (nc && cc) cc.replaceWith(nc);
      window.history.pushState({}, '', url);
      prime();
      if (keep) openFilter(keep, false);
      busy = false;
    }).catch(function () { window.location.href = url; });
  }
  document.addEventListener('click', function (e) {
    var col = q('.nav_filter-col');
    var link = e.target.closest('.nav_filter-value, .nav_applied-chip, .nav_reset');
    if (link && col && col.contains(link)) {
      e.preventDefault();
      if (!link.classList.contains('is-inactive')) go(link.getAttribute('href'));
      return;
    }
    var so = e.target.closest('.nav_sort-option');
    if (so && col && col.contains(so)) {
      e.preventDefault();
      var p = new URLSearchParams(window.location.search);
      p.set('sort_by', so.getAttribute('data-sort'));
      closeSort();
      go(window.location.pathname + '?' + p.toString());
      return;
    }
        var stk = e.target.closest('.nav_stock-toggle');
    if (stk) {
      e.preventDefault();
      var sp = new URLSearchParams(window.location.search);
      if (sp.get('filter.v.availability') === '1') sp.delete('filter.v.availability');
      else sp.set('filter.v.availability', '1');
      go(window.location.pathname + (sp.toString() ? '?' + sp.toString() : ''));
      return;
    }
    var fb = e.target.closest('.nav_filter-btn');
    if (fb) {
      e.preventDefault();
      var key = fb.getAttribute('data-filter');
      if (openKey === key) closeFilter(); else openFilter(key);
      return;
    }
    if (e.target.closest('.nav_sort-btn')) {
      e.preventDefault();
      var sb = q('.nav_sort-btn');
      if (sb.classList.contains('is-open')) closeSort();
      else { closeFilter(); sb.classList.add('is-open');
             var sbar = q('.nav_sort-bar'); if (sbar) sbar.classList.add('is-open');
             var sd = q('.nav_sort-drawer');
             gsap.killTweensOf(sd); gsap.to(sd, { height: 'auto', duration: .4, ease: 'power2.out' }); }
      return;
    }
    if (!e.target.closest('.nav_filter-col')) { closeFilter(); closeSort(); }
  });
  document.addEventListener('mouseover', function (e) {
    if (e.target.closest('.nav_filter-col')) clearTimeout(leaveTimer);
  });
  document.addEventListener('mouseout', function (e) {
    var col = q('.nav_filter-col'); if (!col) return;
    if (col.contains(e.target) && !col.contains(e.relatedTarget)) {
      clearTimeout(leaveTimer);
      leaveTimer = setTimeout(function () { closeFilter(); closeSort(); }, 250);
    }
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') { closeFilter(); closeSort(); }
  });
  window.addEventListener('popstate', function () { window.location.reload(); });
  window.addEventListener('resize', function () {
    if (!openKey) return;
    var fd = q('.nav_filter-drawer'), p = q('[data-filter-panel="' + openKey + '"]');
    if (fd && p) gsap.set(fd, { height: p.offsetHeight });
  });
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', prime);
  else prime();
})();
</script>
</body>
</html>