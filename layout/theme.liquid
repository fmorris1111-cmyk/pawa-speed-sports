  <!--  &#9472;&#9472; PhotoSwipe v5 &mdash; Product Gallery Zoom &#9472;&#9472;  -->
  <script type="module">
  if (!document.querySelector('.swiper-wrapper.is-product-gallery')) {
    throw new Error('PhotoSwipe init skipped: no product gallery on this page.');
  }
  const { default: PhotoSwipeLightbox } = await import('https://unpkg.com/photoswipe@5/dist/photoswipe-lightbox.esm.js');
  const { default: PhotoSwipe }         = await import('https://unpkg.com/photoswipe@5/dist/photoswipe.esm.js');
  await new Promise((resolve) => requestAnimationFrame(resolve));
  document.querySelectorAll('.swiper-container.is-product-gallery').forEach((container) => {
    initGalleryLightbox(container);
  });
  function initGalleryLightbox(container) {
    const allSlides = Array.from(container.querySelectorAll('.swiper-slide.is-product-gallery'));
    const photoswipeItems = [], pswpIndexMap = [], swiperToPswpMap = {};
    allSlides.forEach((slide, swiperIndex) => {
      const img = slide.querySelector('img.product-header_gallery-image');
      if (!img) return;
      const src = img.dataset.zoomSrc || img.src;
      const width = img.naturalWidth || img.width || 0;
      const height = img.naturalHeight || img.height || 0;
      const pswpIndex = photoswipeItems.length;
      photoswipeItems.push({ src, width, height, swiperIndex });
      pswpIndexMap.push(swiperIndex);
      swiperToPswpMap[swiperIndex] = pswpIndex;
    });
    if (photoswipeItems.length === 0) return;
    const galleryEl = container.querySelector('.swiper.is-product-gallery');
    const getSwiperInstance = () => galleryEl && galleryEl.swiper;
    allSlides.forEach((slide, swiperIndex) => {
      const img = slide.querySelector('img.product-header_gallery-image');
      if (!img) return;
      img.style.cursor = 'zoom-in';
      img.addEventListener('click', () => openLightbox(swiperIndex));
    });
    const lightbox = new PhotoSwipeLightbox({
      dataSource: photoswipeItems, pswpModule: PhotoSwipe,
      initialZoomLevel: 'fit', secondaryZoomLevel: 2, maxZoomLevel: 4,
      wheelToZoom: true, padding: { top: 20, bottom: 20, left: 20, right: 20 },
      loop: false, showHideAnimationType: 'fade',
    });
    lightbox.on('loadComplete', (e) => {
      const { slide } = e;
      if (slide.data.width === 0 || slide.data.height === 0) {
        const img = slide.content.element;
        if (img && img.naturalWidth) {
          slide.data.width = img.naturalWidth;
          slide.data.height = img.naturalHeight;
          slide.updateContentSize();
        }
      }
    });
    lightbox.on('change', () => {
      const pswp = lightbox.pswp;
      if (!pswp) return;
      const swiperIndex = pswpIndexMap[pswp.currIndex];
      if (swiperIndex == null) return;
      const swiper = getSwiperInstance();
      if (swiper && swiper.activeIndex !== swiperIndex) swiper.slideTo(swiperIndex, 0);
    });
    lightbox.init();
    function openLightbox(swiperIndex) {
      const pswpIndex = swiperToPswpMap[swiperIndex];
      if (pswpIndex == null) return;
      lightbox.loadAndOpen(pswpIndex);
    }
  }
</script>
